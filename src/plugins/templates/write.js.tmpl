// A write tool, generated by `agent plugin new` from the agent's own example
// (specs/041). Every name, value and address below is invented: replace them
// with your own. The model calls the tool while it writes the reply, and
// `perform` runs once the reply has been sent (specs/036).
import { definePlugin, defineTool } from 'manychat-ai-agent';

// Your backend goes here. This address does not exist, so until it is
// replaced every call fails, and the agent logs the failure and moves on.
const BACKEND_URL = 'https://backend.example.com';

export default definePlugin({
  name: '__PLUGIN_NAME__',
  apiVersion: __API_VERSION__,
  tools: [
    defineTool({
      name: '__TOOL_NAME__',
      // The only guidance the model gets: say when to call the tool, not what
      // it does inside.
      description:
        'Record a call-back request once the contact has named a course and asked to be called.',
      // One parameter of each type a write tool may take. Keep the ones your
      // backend needs, and change their names and values to yours.
      parameters: {
        course: { type: 'enum', values: ['foundation', 'advanced'] },
        seats: { type: 'number', integer: true, min: 1, max: 4, optional: true },
        urgent: { type: 'boolean' },
        summary: { type: 'note', maxLength: 200, optional: true },
      },
      // Throw to report a failure: it is logged and recorded on the turn, and
      // never retried. Pass `signal` to anything that waits.
      async perform({ subscriberId, params, logger, signal }) {
        // Your code goes here: the request your backend expects.
        const response = await fetch(`${BACKEND_URL}/call-backs`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ subscriberId, ...params }),
          signal,
        });
        if (!response.ok) throw new Error(`backend answered ${response.status}`);
        logger.info('call-back recorded', { course: params.course });
      },
    }),
  ],
});

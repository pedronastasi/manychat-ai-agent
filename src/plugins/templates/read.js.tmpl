// A read tool, generated by `agent plugin new` from the agent's own example
// (specs/041). Every name, value and address below is invented: replace them
// with your own. The model calls the tool while it writes the reply, and is
// shown only the result it declares, checked by the agent (specs/039).
import { definePlugin, defineReadTool } from 'manychat-ai-agent';

// Your backend goes here. This address does not exist, so until it is
// replaced every call fails, and the model is told the answer is unavailable.
const BACKEND_URL = 'https://backend.example.com';

export default definePlugin({
  name: '__PLUGIN_NAME__',
  apiVersion: __API_VERSION__,
  tools: [
    defineReadTool({
      name: '__TOOL_NAME__',
      // The only guidance the model gets: say when to call the tool, not what
      // it does inside.
      description:
        'Look up whether an offering has room and when its next slot is, when the contact asks whether they can have it or when.',
      // One parameter of each type a read tool may take. Keep the ones your
      // backend needs, and change their names and values to yours. The query
      // is the one free text, and the agent removes identifiers from it.
      parameters: {
        offering: { type: 'enum', values: ['basic', 'premium'] },
        quantity: { type: 'number', integer: true, min: 1, max: 12, optional: true },
        flexible: { type: 'boolean', optional: true },
        query: { type: 'query', maxLength: 120, optional: true },
      },
      // What the model is shown. A value outside these declarations makes the
      // whole read unavailable, so declare exactly what you return.
      result: {
        slotsLeft: { type: 'number', integer: true, min: 0 },
        nextSlot: { type: 'enum', values: ['this_week', 'next_week', 'later'] },
        waitlist: { type: 'boolean' },
        summary: { type: 'text', maxLength: 300, optional: true },
      },
      // Throw, or take too long, and the model is told the answer is
      // unavailable. Pass `signal` to anything that waits.
      async read({ params, signal }) {
        // Your code goes here: the request your backend expects.
        const url = new URL('/availability', BACKEND_URL);
        for (const [key, value] of Object.entries(params)) url.searchParams.set(key, String(value));
        const response = await fetch(url, { signal });
        if (!response.ok) throw new Error(`backend answered ${response.status}`);
        const found = await response.json();
        // Return only what `result` declares.
        return {
          slotsLeft: found.slotsLeft,
          nextSlot: found.nextSlot,
          waitlist: found.waitlist,
          ...(found.summary ? { summary: found.summary } : {}),
        };
      },
    }),
  ],
});

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "messages": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "escalate": {
      "type": "boolean"
    },
    "escalation_reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "price_negotiation",
            "complaint",
            "out_of_scope",
            "explicit_request",
            "low_confidence",
            "payment_reported"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "closing_question": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ],
      "description": "The single question that ends this turn, or null when no question belongs here. Written on its own, without prices, list items or explanations — it is appended as the final message, so it must read as a complete question by itself."
    },
    "notes": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ],
      "description": "Private working notes: the contact never sees them and the system discards them. Weigh a rule or check a fact here, in a line or two, or send null."
    }
  },
  "required": [
    "messages",
    "escalate",
    "escalation_reason",
    "confidence",
    "closing_question",
    "notes"
  ],
  "additionalProperties": false
}

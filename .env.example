# ---- Model ------------------------------------------------------------------
# provider:model — switching provider is an edit here and a restart (ADR-0002).
#   anthropic:claude-haiku-4-5   openai:gpt-5-mini   google:gemini-2.5-flash
# Model IDs carry no date suffix.
AGENT_MODEL=anthropic:claude-haiku-4-5
# Reasoning models (openai:gpt-5*, openai:o*) spend this budget on reasoning
# BEFORE emitting any reply, and run out mid-thought at 400: the turn returns no
# text at all and every reply escalates. Measured 2026-09-15 against the demo
# catalog, gpt-5-mini used ~900 reasoning tokens before its first output token.
# A production catalog costs more: gpt-5-mini was still closing turns at 1455 of
# a 1500 ceiling and failing outright past it, so treat ~1500 as a floor rather
# than a fix. Raising the ceiling only buys room for deliberation you are also
# paying for; AGENT_REASONING_EFFORT below caps the deliberation instead.
AGENT_MAX_OUTPUT_TOKENS=400
AGENT_TEMPERATURE=0.3
# Reasoning models only — unset sends nothing, so non-reasoning models are
# unaffected. Answering from a fixed catalog rarely rewards deliberation, and
# 'low' buys back both the latency that loses the race and the output budget
# that otherwise runs out mid-thought.
# AGENT_REASONING_EFFORT=low
# The turn runs on LangChain.js and LangGraph.js (ADR-0026, ADR-0027). The AI
# SDK runner was removed (specs/050), so AGENT_RUNNER=ai-sdk stops boot; leave
# AGENT_RUNNER unset. LangChain's own tracing switches (LANGSMITH_TRACING and
# its siblings) and LANGCHAIN_VERBOSE stop boot too (C5).

# Turn traces in your own LangSmith workspace (specs/052). A live trace carries
# timings, token counts, node and tool names and how the turn ended, never a
# prompt, a message or a reply. Off unless set; the key and project are then
# required.
# TRACE_TURNS=langsmith
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
# A workspace outside the default region:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Voice notes and video soundtracks are transcribed by a second model, in the
# same provider:model form (specs/020). Unset, a voice note gets the tenant's
# rules.messages.mediaFallback, asking the contact to type it. Anthropic has no
# transcription model, so this needs another provider's key as well:
#   openai:gpt-4o-mini-transcribe   openai:gpt-4o-transcribe   openai:whisper-1
# TRANSCRIPTION_MODEL=openai:gpt-4o-mini-transcribe

# The analyst of the weekly learning job (specs/031), off the request path.
# Unset, the job does not run. Needs a "learning" block in rules.json too.
# INSIGHT_MODEL=anthropic:claude-sonnet-5

# Only the ACTIVE providers' keys are required.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# ---- Ollama (local model) ---------------------------------------------------
# Start with: docker compose --profile local-model up
# Then: AGENT_MODEL=ollama:llama3.1:8b pnpm simulate "hola"
# The first run pulls ~4.7 GB of weights; they persist in a named volume.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Inside compose the agent service overrides this to http://ollama:11434/v1.

# ---- Channel ----------------------------------------------------------------
# The channel of a request that names none. Each channel's External Request
# names its own with a literal "channel" field (specs/048).
CHANNEL=whatsapp
# The channels this deployment answers, comma-separated: whatsapp, instagram,
# messenger. Empty means CHANNEL alone. A request naming another gets a 400.
CHANNELS=
# HTTPS base used to build external_message_callback. Must be publicly reachable.
PUBLIC_BASE_URL=https://agent.example.com

# Proxies whose X-Forwarded-For is believed: addresses, CIDR ranges, or the
# presets loopback, linklocal, uniquelocal. Empty trusts none, so every request
# is keyed to the socket peer. Behind a reverse proxy, list the proxy, or every
# caller shares one rate-limit budget (specs/017).
TRUST_PROXY=

# Validates inbound Dynamic Block requests. Comma-separate two values during
# rotation so ManyChat flows need no downtime (ADR-0012); SECURITY.md has the
# steps, including the 24-hour wait before removing the old one. Minimum 16 chars.
#   openssl rand -hex 32
MANYCHAT_SHARED_SECRET=change-me-to-a-long-random-string

# Required for the deferred push when the model loses the race.
MANYCHAT_API_TOKEN=
MANYCHAT_API_BASE=https://api.manychat.com

# Deferred delivery is two calls: write the reply to a per-subscriber custom
# field, then trigger a flow that renders it (specs/002). Both name objects that
# live in the ManyChat account, so renaming them there breaks delivery silently.
MANYCHAT_REPLY_FIELD=ai_message
MANYCHAT_REPLY_FLOW_NS=
# A flow is authored per channel, so Instagram and Messenger each need their
# own reply flow when listed in CHANNELS. Their replies are delivered only
# inside the 24-hour window; past it they are dead-lettered and escalated.
MANYCHAT_REPLY_FLOW_NS_INSTAGRAM=
MANYCHAT_REPLY_FLOW_NS_MESSENGER=
# The pause between two messages of a deferred reply, and between two replies
# to one contact. A flow reads the field when its message step runs, which can
# be after the trigger has returned, so the next message must not overwrite it
# sooner. Never pace with a delay before that step inside the flow: the field
# would be overwritten while it waits (specs/002).
MANYCHAT_REPLY_GAP_MS=2000

# Each contact's token lives in this custom field, and the Dynamic Block body
# sends it back as "ai_token": "{{ai_token}}". Only a request carrying it reads
# the contact's history (specs/019, ADR-0012).
MANYCHAT_TOKEN_FIELD=ai_token
# false only during the rollout in specs/019, while tokens reach existing
# contacts; a request without the token then reads history as it used to.
CONTACT_TOKENS_ENFORCED=true

# ---- Storage ----------------------------------------------------------------
DATABASE_URL=postgres://agent:agent@localhost:5432/agent
TENANT_ID=demo

# ---- Timeouts ---------------------------------------------------------------
# ManyChat hard-terminates at 10000ms, so the race deadline sits below it.
RACE_DEADLINE_MS=8000
# MODEL_ABORT_MS must be GREATER than RACE_DEADLINE_MS. Losing the race does not
# cancel the model call - it keeps running and delivers via the outbox - so this
# is the outer safety net that stops a runaway call, not the race timeout.
MODEL_ABORT_MS=30000

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---- Evals (tooling, not runtime) -------------------------------------------
# Not part of EnvSchema: nothing validates these, and a typo silently falls back
# to the default rather than failing at boot.
#
# Left commented deliberately. `pnpm eval` loads this file via --env-file, so an
# uncommented value here would pin every run and defeat the per-invocation form:
#   EVAL_DIR=evals/tenant CONFIG_DIR=config pnpm eval
#
# Which suite to replay (specs/009-tenant-eval-suites.md). A tenant deploying
# from a private overlay keeps its own cases out of the framework's set.
# EVAL_DIR=evals/golden
#
# Which tenant config the suite runs against. CI points this at the fixtures.
# `pnpm dev` reads it too, so a bug can be reproduced against the fixture tenant
# (specs/021-contributor-surface.md).
# CONFIG_DIR=config
#
# How slow a reply may be before the suite fails it. Defaults to
# RACE_DEADLINE_MS. Raise it here rather than raising RACE_DEADLINE_MS: that one
# is bounded by ManyChat's 10s cutoff and governs the live race, whereas a turn
# that merely overruns it in an eval is not wrong - it is deferred to the outbox
# and delivered. A tenant on a reasoning model wants a looser figure for the
# suite without touching the request path.
# EVAL_MAX_LATENCY_MS=30000
#
# A second model that grades replies during `pnpm eval`, as provider:model
# (specs/016-model-graded-evals.md). Every run calibrates it first against
# <EVAL_DIR>/calibration.jsonl, and only the groups it agrees with unanimously
# grade anything. Three calls per criterion per case, plus three per calibration
# item. Unset: no judge, and the suite behaves as specs/009 defines.
# EVAL_JUDGE_MODEL=anthropic:claude-sonnet-5-5

# Where `agent eval conversations` writes its JSON and Markdown reports
# (specs/043). They are transcripts: keep the directory out of git.
# EVAL_ARTIFACTS_DIR=.eval-artifacts

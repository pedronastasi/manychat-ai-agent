{
  "name": "manychat-ai-agent",
  "version": "0.15.3",
  "description": "A provider-agnostic conversational AI agent gateway that bridges no-code chat platforms to any LLM.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedronastasi/manychat-ai-agent.git"
  },
  "type": "module",
  "bin": {
    "agent": "dist/cli.js"
  },
  "exports": {
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist/",
    "db/migrations/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env --watch src/main.ts",
    "bootstrap": "node scripts/setup.mjs",
    "spec:index": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/spec-index.ts",
    "docs:api": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/export-openapi.ts",
    "docs:build": "pnpm docs:api && vitepress build",
    "docs:dev": "pnpm docs:api && vitepress dev",
    "docs:preview": "vitepress preview",
    "demo:record": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/record-demo.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "simulate": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env src/channels/manychat/simulator.ts",
    "eval": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env evals/run.ts",
    "eval:mock": "node --experimental-strip-types --disable-warning=ExperimentalWarning evals/run.ts",
    "tokens:backfill": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env src/backfill.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "worker": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file=.env src/outbox/worker.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.53",
    "@ai-sdk/google": "^4.0.69",
    "@ai-sdk/openai": "^4.0.66",
    "@ai-sdk/provider": "4.0.21",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/under-pressure": "^9.1.0",
    "ai": "^7.0.100",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "fastify-type-provider-zod": "^7.0.0",
    "manychat-sdk": "^0.1.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "mermaid": "^12.0.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.0",
    "vue": "^3.5.43",
    "yaml": "^2.9.1"
  }
}
